{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "browser-assistant": ["../src/index.ts"],
      "browser-assistant/*": ["../src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
